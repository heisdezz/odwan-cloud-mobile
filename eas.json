{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "debug": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.4.0",
      "env": {
        "EXPO_NO_DOTENV": "1"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true
      }
    }
  }
}
